@app.route("/api/auth/2fa/status")
@login_required
def auth_2fa_status():
    _resolve_identity()
    if g.auth_kind == "db" and g.db_user:
        u = g.db_user
        return jsonify({
            "username": u.username,
            "totp_enabled": bool(u.totp_enabled),
            "backup_codes_remaining": 0,
        })
