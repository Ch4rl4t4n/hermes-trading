[Unit]
Description=Hermes FastAPI v2 service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/hermes
Environment=PATH=/root/hermes/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/root/hermes/.env
ExecStart=/root/hermes/venv/bin/uvicorn hermes_api_v2.main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
