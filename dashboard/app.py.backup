@app.route("/api/backtest/run", methods=["POST"])
@login_required
@require_tier(TIER_MEDIUM)
def api_backtest_run():
    data = request.get_json(silent=True) or {}
    raw_sym = str(data.get("symbol") or "").strip()
    if not raw_sym:
        return jsonify({"error": "Symbol is required"}), 400
    canonical = None
    for c in _load_configs():
        if c.symbol == raw_sym or c.symbol.replace("/", "-") == raw_sym.replace("/", "-"):
            canonical = c.symbol
            break
    if not canonical:
        canonical = _url_to_symbol(raw_sym.replace("/", "-"))
    if not canonical:
        return jsonify({"error": f"Unknown symbol: {raw_sym}"}), 400
    strategy = str(data.get("strategy") or "trending").strip().lower()
    start_date = str(data.get("start_date") or "").strip()
    end_date = str(data.get("end_date") or "").strip()
    if not start_date or not end_date:
        end_d = datetime.now(timezone.utc).date()
        start_d = end_d - timedelta(days=30)
        start_date = start_date or start_d.isoformat()
        end_date = end_date or end_d.isoformat()
    timeframe = str(data.get("timeframe") or "1Hour").strip()
    initial_capital = float(data.get("initial_capital") or 100_000)
    trading_mode = (data.get("trading_mode") or "day_trading") or "day_trading"
    compare_modes = bool(data.get("compare_modes") or data.get("compare"))
    try:
        from core.backtester import submit_backtest_job

        job_id = submit_backtest_job(
            {
                "symbol": canonical,
                "strategy": strategy,
                "start_date": start_date,
                "end_date": end_date,
                "timeframe": timeframe,
                "initial_capital": initial_capital,
                "trading_mode": trading_mode,
                "compare_modes": compare_modes,
            }
        )
        return jsonify({"job_id": job_id, "status": "running"})
    except Exception as exc:  # noqa: BLE001
        log.warning("backtest submit: %s", exc)
        return jsonify({"error": str(exc)}), 500


