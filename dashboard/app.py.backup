            "id": u.id,
            "email": u.email,
            "username": u.username,
            "tier": u.tier,
            "is_admin": u.is_admin,
            "totp_enabled": u.totp_enabled,
            "account": acct_payload,
            "features": features_payload(u),
        })
    un = _current_username()
    return jsonify({
        "username": un,
        "auth_kind": "legacy",
        "is_admin": (auth.get_user_public(un or "") or {}).get("role") == "admin",
        "features": unrestricted_features_payload(),
    })


