def _api_rate_limit_key() -> str:
    uid = session.get("user_id")
    if uid is not None and session.get("auth_kind") == "db":
        try:
            return f"uid:{int(uid)}"
        except (TypeError, ValueError):
            pass
    return f"ip:{get_remote_address()}"


